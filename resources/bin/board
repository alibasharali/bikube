#!/bin/sh
# board: tells Bikube's board what this card is doing (`board help`). Bikube prepends this directory
# to PATH in every card's shell environment and sets the variables below (#9 D3, D4); it runs Bikube's
# bundled CLI with Bikube's own executable as Node, so nothing needs installing.
if [ -z "${BIKUBE_EXECUTABLE:-}" ] || [ -z "${BIKUBE_BOARD_CLI:-}" ]; then
  echo "board: not running inside a Bikube card" >&2
  exit 1
fi
ELECTRON_RUN_AS_NODE=1 exec "$BIKUBE_EXECUTABLE" "$BIKUBE_BOARD_CLI" "$@"
